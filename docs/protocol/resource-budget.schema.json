{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshogi.example/schemas/resource-budget-v1.json",
  "title": "OpenShogiAI resource budget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "playThreads",
    "analysisThreads",
    "playHashMegabytes",
    "analysisHashMegabytes",
    "analysisPauseDuringAiTurn",
    "maximumAggregateMemoryMegabytes"
  ],
  "properties": {
    "schema": { "const": "open_shogi_resource_budget/v1" },
    "playThreads": { "const": 1 },
    "analysisThreads": { "type": "integer", "minimum": 0, "maximum": 1 },
    "playHashMegabytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "analysisHashMegabytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
    "analysisPauseDuringAiTurn": { "type": "boolean" },
    "maximumAggregateMemoryMegabytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    }
  }
}
