{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openshogiai.example/schema/osaval02-parity-corpus-v1.json",
  "title": "OpenShogiAI OSAVAL02 parity corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provenancePolicy", "fixtures"],
  "properties": {
    "schema": {"const": "open_shogiai_osaval02_parity_corpus/v1"},
    "provenancePolicy": {
      "const": "synthetic positions only; no game records, evaluations, labels, or training examples"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/fixture"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "repetitionCount", "continuousCheckByUs", "continuousCheckByThem"],
      "properties": {
        "available": {"type": "boolean"},
        "repetitionCount": {"type": "integer", "minimum": 1, "maximum": 4},
        "continuousCheckByUs": {"type": "boolean"},
        "continuousCheckByThem": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "containsLabels"],
      "properties": {
        "kind": {"const": "synthetic-rule-state"},
        "source": {"const": "hand-authored-from-public-shogi-rules"},
        "containsLabels": {"const": false}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "sfen", "categories", "positionSha256", "provenance"],
      "properties": {
        "fixtureId": {"type": "string", "minLength": 1, "maxLength": 64},
        "sfen": {"type": "string", "minLength": 1, "maxLength": 1024},
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "positionSha256": {"$ref": "#/$defs/sha256"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "history": {"$ref": "#/$defs/history"}
      }
    }
  }
}
